# 复制成 .env 再改。这个文件不要提交到 git。

# ------------------------------------------------------------------ 必填
# 你的域名（A 记录要指向这台服务器）。Caddy 用它自动签 HTTPS 证书。
STZB_DOMAIN=stzb.example.com

# Let's Encrypt 到期提醒邮箱，建议填
ACME_EMAIL=you@example.com

# ------------------------------------------------------------------ 首次启动凭据
# 不填就随机生成，并在 docker compose logs app 里打印一次。
# 建议第一次直接在这里写好，省得去翻日志。
STZB_ADMIN_USER=admin
STZB_ADMIN_PASSWORD=
STZB_AGENT_TOKEN=

# 会话签名密钥。留空会自动生成一次并存在数据库里（重启不失效）。
# 想自己指定就填一串 40 位以上的随机字符。
STZB_SECRET_KEY=

# ------------------------------------------------------------------ 可选
# 单文件上传上限（字节）。报告约 3MB，默认 24MB
STZB_MAX_UPLOAD_BYTES=25165824
# 每轮最多接受多少张截图
STZB_MAX_SHOTS_PER_RUN=60
# 保留最近多少轮（0 = 不清理）。
# 磁盘估算：每轮约 3MB 报告 + 20 张缩略图约 2MB ≈ 5MB，120 轮 ≈ 600MB
STZB_KEEP_RUNS=120
# 是否允许在控制台排「待执行任务」让脚本来领（1 开 / 0 关）
STZB_ALLOW_RUN_REQUESTS=1

# ------------------------------------------------------------------ 客户端探活
# 服务端在公网、客户端在内网，服务端连不进去，所以在线状态由客户端主动心跳决定。
# 客户端每 interval 秒心跳一次，服务端记 last_seen；超过 offline_after 秒判掉线。
STZB_HEARTBEAT_INTERVAL=30
STZB_CLIENT_OFFLINE_AFTER=90
