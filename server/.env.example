# 复制成 .env 再改。这个文件不要提交到 git。
#
# 本文件按「内网部署」写：后端就跑在你自己的电脑 / 内网服务器上，
# 手机和别的电脑在同一个局域网里直接访问 http://<内网IP>:8000 即可。
# 不需要域名、不需要 HTTPS 证书、不需要反向代理。
#
# 想改成公网部署（可选进阶）见文件末尾。

# ------------------------------------------------------------------ 必填
# 首次启动凭据。不填会自动随机生成，并在启动日志里打印一次。
# 建议第一次直接在这里写好，省得去翻日志。
STZB_ADMIN_USER=admin
STZB_ADMIN_PASSWORD=
STZB_AGENT_TOKEN=

# 会话签名密钥。留空会自动生成一次并存在数据库里（重启不失效）。
# 想自己指定就填一串 40 位以上的随机字符。
STZB_SECRET_KEY=

# ------------------------------------------------------------------ 可选
# 单文件上传上限（字节）。报告约 3MB，默认 24MB
STZB_MAX_UPLOAD_BYTES=25165824
# 每轮最多接受多少张截图
STZB_MAX_SHOTS_PER_RUN=60
# 保留最近多少轮（0 = 不清理）。
# 磁盘估算：每轮约 3MB 报告 + 20 张缩略图约 2MB ≈ 5MB，120 轮 ≈ 600MB
STZB_KEEP_RUNS=120
# 是否允许在控制台排「待执行任务」让脚本来领（1 开 / 0 关）
STZB_ALLOW_RUN_REQUESTS=1

# ------------------------------------------------------------------ 客户端探活
# 后端和采集客户端在同一个内网，但客户端仍是「主动心跳上报」：
# 客户端每 interval 秒心跳一次，后端记 last_seen；超过 offline_after 秒判掉线。
# 这样即使客户端在另一台机器、或以后搬到公网，逻辑都不用改。
STZB_HEARTBEAT_INTERVAL=30
STZB_CLIENT_OFFLINE_AFTER=90

# ------------------------------------------------------------------ 公网部署（可选进阶，内网用不到）
# 仅当你确实想把控制台暴露到公网时再打开下面两项：
#   1) STZB_DOMAIN 填你的域名（A 记录指向服务器）
#   2) ACME_EMAIL 填 Let's Encrypt 到期提醒邮箱
# 然后用 server\Caddyfile + docker-compose.yml 起 Caddy 自动签 HTTPS。
# 内网部署请保持这两行为空 / 注释状态。
# STZB_DOMAIN=stzb.example.com
# ACME_EMAIL=you@example.com
